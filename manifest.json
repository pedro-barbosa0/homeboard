{
  "manifest_version": 3,
  "name": "Homeboard",
  "version": "1.5.0",
  "description": "A personal board for your new tab: notes, to-do lists, quick links, website windows and strings between them.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "scripting",
    "system.display"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "ytm.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "file:///*"
      ],
      "include_globs": [
        "*.md",
        "*.MD",
        "*.markdown"
      ],
      "js": [
        "markdown.js",
        "fileview.js",
        "mdview.js"
      ],
      "css": [
        "fileview.css",
        "mdview.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "frame.js"
      ],
      "css": [
        "noscroll.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Homeboard",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "homeboard@localhost",
      "strict_min_version": "128.0"
    }
  }
}
